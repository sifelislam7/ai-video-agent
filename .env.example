# =========================================================
#  AI Video Agent — environment configuration
#  نسخ هذا الملف إلى .env ثم املأ ما تحتاجه فقط
#  cp .env.example .env
# =========================================================

# ---------- Server ----------
APP_HOST=0.0.0.0
APP_PORT=8000
# Public base URL of this app. Required for TikTok OAuth callback and for
# PULL_FROM_URL publishing (TikTok must be able to download the media).
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Provider selection ----------
# auto = use the first provider that has a key, otherwise fall back to "local"
# text  : auto | openai | gemini | openrouter | local
# image : auto | openai | gemini | replicate | local
# tts   : auto | openai | elevenlabs | local
# video : auto | replicate | ffmpeg        (ffmpeg = slideshow assembled locally)
TEXT_PROVIDER=auto
IMAGE_PROVIDER=auto
TTS_PROVIDER=auto
VIDEO_PROVIDER=auto

# ---------- OpenAI (text + image + tts) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---------- Google Gemini (text + image) ----------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# ---------- OpenRouter (text, optional) ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# ---------- ElevenLabs (tts) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------- Replicate (image + video) ----------
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=

# ---------- TikTok ----------
# Create an app at https://developers.tiktok.com/ and add the
# "Content Posting API" product. Scopes: user.info.basic,video.publish,video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match EXACTLY the redirect URI registered in the TikTok developer portal
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/callback
# mock  = never calls TikTok, writes a fake publish record (safe for testing)
# live  = calls the real Content Posting API
TIKTOK_MODE=mock
# FILE_UPLOAD (works from localhost) | PULL_FROM_URL (needs a verified public domain)
TIKTOK_UPLOAD_SOURCE=FILE_UPLOAD
# DIRECT_POST = publish immediately | INBOX = send to the creator's drafts
TIKTOK_POST_TARGET=DIRECT_POST
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
# NOTE: unaudited apps are forced to SELF_ONLY by TikTok.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---------- Agent defaults ----------
DEFAULT_LANGUAGE=ar
DEFAULT_SCENE_COUNT=5
DEFAULT_VIDEO_SECONDS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# ---------- Scheduler ----------
# Background worker that publishes scheduled posts
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
